#!/bin/zsh
# moneta-installer : --racine DIR [--ecosysteme] : écrit installation.toml (hors Git, 600) et prépare le dossier réel (voir moneta/scripts/installer.py). Une seule fois.
set -eu
ROOT="${0:A:h:h}"
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT" exec "$ROOT/.venv/bin/python" "$ROOT/moneta/scripts/installer.py" "$@"
