#!/bin/zsh
# Compile moneta-releve (PDFKit de macOS : texte d'un relevé PDF, sans rien interpréter) dans $MONETA_HOME/apps, pour les relevés bancaires.
# Le programme neuf est construit, signé et vérifié à côté, puis mis en place d'un coup. Programmes par leur chemin complet.
# Toujours construit ici depuis moneta/releve, jamais copié de l'ancien lecteur de Smith (apps/agent-smith-releve, spec 013).
set -eu
ROOT="${0:A:h:h}"
CODE="$ROOT/moneta/releve"
# Le dossier des données vient de moneta.chemins.home(), même règle que tout Moneta : un MONETA_HOME sous ~/_PersonalAgents
# n'est jamais suivi; ici il est refusé, plutôt que de construire en silence dans les vraies données (revue T074 de Smith, R11).
DONNEES="$(cd "$ROOT" && PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT" "$ROOT/.venv/bin/python" -c 'from moneta.chemins import home; print(home())')"
if [[ -n "${MONETA_HOME:-}" && "$DONNEES" != "${MONETA_HOME:A}" && "$DONNEES" != "$MONETA_HOME" ]]; then
  echo "Refusé : MONETA_HOME ($MONETA_HOME) n'est pas suivi (sous ~/_PersonalAgents, seul le vrai dossier de Moneta sert); rien n'est construit." >&2
  exit 1
fi
MONETA_HOME="$DONNEES"
APPS="$MONETA_HOME/apps"
BIN="$APPS/moneta-releve"
NEW="$APPS/.moneta-releve.neuf"
# Jamais à travers un lien : le lecteur irait ailleurs que dans les données de Moneta.
if [[ -L "$MONETA_HOME" || -L "$APPS" || -L "$BIN" ]]; then
  echo "Refusé : $APPS ou $BIN est un lien." >&2
  exit 1
fi
# Chaque niveau manquant en 700, jamais 755 (R9).
/bin/mkdir -m 700 "$MONETA_HOME" 2>/dev/null || true
/bin/mkdir -m 700 "$APPS" 2>/dev/null || true
/bin/chmod 700 "$APPS"
/bin/rm -f "$NEW"
/usr/bin/swiftc -O -o "$NEW" "$CODE/main.swift"
# Seul fichier des données de Moneta en 700 (exécutable), comme le contrôle moneta-verifier l'attend.
/bin/chmod 700 "$NEW"
/usr/bin/codesign -s - --force "$NEW"
/usr/bin/codesign --verify --strict "$NEW"
/bin/mv -f "$NEW" "$BIN"
echo "OK : $BIN"
