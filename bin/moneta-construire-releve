#!/bin/zsh
# Compile moneta-releve (PDFKit de macOS : texte d'un relevé PDF, sans rien interpréter) dans $MONETA_HOME/apps, pour les relevés bancaires.
# Le programme neuf est construit, signé et vérifié à côté, puis mis en place d'un coup. Programmes par leur chemin complet.
set -eu
ROOT="${0:A:h:h}"
CODE="$ROOT/moneta/releve"
MONETA_HOME="${MONETA_HOME:-$HOME/_PersonalAgents/donnees/moneta}"
APPS="$MONETA_HOME/apps"
BIN="$APPS/moneta-releve"
NEW="$APPS/.moneta-releve.neuf"
/bin/mkdir -p -m 700 "$APPS"
/bin/rm -f "$NEW"
/usr/bin/swiftc -O -o "$NEW" "$CODE/main.swift"
/usr/bin/codesign -s - --force "$NEW"
/usr/bin/codesign --verify --strict "$NEW"
/bin/mv -f "$NEW" "$BIN"
echo "OK : $BIN"
